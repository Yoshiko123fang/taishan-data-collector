# 复制本文件为 .env 并填入真实值（本地开发可留空，默认 local 模式）

# 运行模式：local（本地/局域网）或 supabase（公网部署）
MODE=local

# 汇总端查看密码（默认 rgzn2026）
PASSWORD=rgzn2026

# 监听端口
PORT=3000

# ===== 以下仅 MODE=supabase 时需要 =====
# 本项目真实地址（已确认）：
SUPABASE_URL=https://ddhhmoxcvqocraevcnqs.supabase.co
# Project Settings -> API -> 复制标注 service_role（或 sb_secret_ 开头）的密钥，保密勿泄露
# 注意：sb_publishable_ 开头的是前端/匿名密钥，服务端不能用它（汇总端密码会失效）
SUPABASE_SERVICE_KEY=
